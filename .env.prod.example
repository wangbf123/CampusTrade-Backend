APP_PORT=8080
APP_ENV_FILE=.env.prod
SPRING_PROFILES_ACTIVE=prod,mysql,redis,rabbitmq
JAVA_OPTS=-Xms512m -Xmx1024m

# Copy this file to .env.prod and replace every change_me/example.com value.
# With prod profile enabled, the app refuses to start with placeholder secrets.

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=campus_trade
MYSQL_USERNAME=campus
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_MAX_POOL_SIZE=20
MYSQL_MIN_IDLE=4
MYSQL_CONNECTION_TIMEOUT_MS=3000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
REDIS_TIMEOUT=2s

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=change_me_mq
RABBITMQ_DEFAULT_USER=campus
RABBITMQ_DEFAULT_PASS=change_me_mq

APP_AUTH_TOKEN_TTL_MINUTES=720
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_ADMIN_BOOTSTRAP_USERNAME=admin
APP_ADMIN_BOOTSTRAP_PASSWORD=change_me_at_least_12_chars
APP_ADMIN_BOOTSTRAP_NICKNAME=System Admin
APP_REGISTRATION_INVITE_CODE_REQUIRED=false
APP_CACHE_ITEM_DETAIL_TTL_SECONDS=1800
APP_CACHE_NULL_ITEM_TTL_SECONDS=120
APP_CACHE_RANDOM_JITTER_SECONDS=300
APP_ORDER_TIMEOUT_HOURS=24
APP_ORDER_TIMEOUT_SCAN_DELAY_MS=60000
APP_ORDER_TIMEOUT_BATCH_SIZE=50
APP_ORDER_TIMEOUT_RETRY_DELAY_SECONDS=60
APP_OUTBOX_PUBLISH_DELAY_MS=3000
APP_OUTBOX_BATCH_SIZE=20
APP_OUTBOX_MAX_RETRY=5
RABBITMQ_PREFETCH=20
APP_STORAGE_TYPE=local
APP_STORAGE_IMAGE_DIR=/app/uploads/images
APP_STORAGE_PUBLIC_BASE_PATH=/uploads/images
APP_STORAGE_PUBLIC_BASE_URL=
APP_STORAGE_MAX_IMAGE_SIZE_BYTES=5242880
# Switch APP_STORAGE_TYPE=s3 after preparing MinIO/OSS/COS credentials.
APP_STORAGE_S3_ENDPOINT=http://minio:9000
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_BUCKET=campustrade
APP_STORAGE_S3_ACCESS_KEY=change_me_minio_access
APP_STORAGE_S3_SECRET_KEY=change_me_minio_secret
APP_MULTIPART_MAX_FILE_SIZE=5MB
APP_MULTIPART_MAX_REQUEST_SIZE=20MB
APP_CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
APP_OBSERVABILITY_REQUEST_ID_HEADER=X-Request-Id
APP_OBSERVABILITY_SLOW_REQUEST_ENABLED=true
APP_OBSERVABILITY_SLOW_REQUEST_THRESHOLD_MS=1000
APP_PRODUCTION_READINESS_ENABLED=true
# Nginx only exposes /actuator/metrics and /actuator/prometheus to this CIDR.
ACTUATOR_ALLOW_CIDR=127.0.0.1/32

DOMAIN=api.example.com
