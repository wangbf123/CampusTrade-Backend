upstream campustrade_backend {
    server app:8080;
    keepalive 32;
}

map $http_x_request_id $campustrade_request_id {
    default $http_x_request_id;
    "" $request_id;
}

server {
    listen 80;
    server_name ${DOMAIN};
    client_max_body_size 10m;

    location = /actuator/health {
        proxy_pass http://campustrade_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $campustrade_request_id;
    }

    location ~ ^/actuator/(metrics|prometheus)(/.*)?$ {
        allow ${ACTUATOR_ALLOW_CIDR};
        deny all;
        proxy_pass http://campustrade_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $campustrade_request_id;
    }

    location = /actuator {
        return 404;
    }

    location /actuator/ {
        return 404;
    }

    location / {
        proxy_pass http://campustrade_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $campustrade_request_id;
    }
}
